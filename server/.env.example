# VibeHub 服务端环境变量模板
#
# 服务**不会自动读取**这个文件：本地开发用 `set -a; source server/.env; set +a`，
# 生产用 systemd 的 EnvironmentFile（见 docs/handbook/deployment.md）。
# 复制成 server/.env 后按需改；真实密钥不要提交。

# ── 必填（生产）────────────────────────────────────────────
# 预览访问 claim 的 HMAC 密钥，少于 32 字符时生产启动会直接失败。
# 轮换会让所有未过期的预览链接立即失效。生成：openssl rand -hex 32
VIBEHUB_PREVIEW_CLAIM_SECRET=

# ── 运行位置 ───────────────────────────────────────────────
# 数据根目录，存放 db.sqlite / versions / sites / previews / uploads / tmp。
# 默认 ~/.vibehub-data；生产用 /var/lib/vibehub。
VIBEHUB_DATA_DIR=
VIBEHUB_PORT=4300
VIBEHUB_HOST=127.0.0.1

# ── 对外地址 ───────────────────────────────────────────────
# 控制台来源，用于 CORS 与 cookie 作用域。开发默认 http://localhost:5173。
VIBEHUB_CONSOLE_ORIGIN=
# 作品站点根地址，决定软链生成的作品 URL 前缀。
VIBEHUB_WORKS_ORIGIN=
VIBEHUB_WORKS_PREFIX=/vibehub
# 逐预览独立 origin 模板，{previewId} 会被替换。
# 生产默认 https://{previewId}.preview.supermind-ai.cn
VIBEHUB_PREVIEW_ORIGIN_TEMPLATE=

# ── 模型网关（AI 诊断翻译；留空则只用确定性结论）─────────────
VIBEHUB_MODEL_GATEWAY_URL=
VIBEHUB_MODEL_GATEWAY_TOKEN=

# ── 配额 ───────────────────────────────────────────────────
# 单个作品可用磁盘上限，默认 200 MB（历史归档脚本可放宽到 400 MB）。
VIBEHUB_PROJECT_DISK_BYTES=

# ── 本地调试 ───────────────────────────────────────────────
# 允许预览探针访问私网地址。仅本机开发用，生产不要开。
VIBEHUB_ALLOW_PRIVATE_PREVIEW_PROBE=
NODE_ENV=development
LOG_LEVEL=info
