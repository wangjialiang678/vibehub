#!/usr/bin/env node
/**
 * vibehub —— 把你的作品交给 VibeHub。
 * 零依赖，Node ≥ 20。学员的 AI 工具调用它。
 */
import { linkSync, readFileSync, writeFileSync, mkdirSync, existsSync, statSync, readdirSync, chmodSync, rmSync, renameSync, realpathSync, lstatSync } from 'node:fs';
import { homedir, tmpdir } from 'node:os';
import { join, resolve, relative, basename, dirname, isAbsolute } from 'node:path';
import { createHash, randomBytes } from 'node:crypto';
import { execFileSync } from 'node:child_process';
import { platformCommands } from '../lib/platform.mjs';

const CRED_DIR = join(homedir(), '.vibehub');
const CRED = join(CRED_DIR, 'credentials.json');
const BINDING_DIR = '.vibehub';
const BINDING_FILE = 'project.json';
const PROJECT_CREATE_LOCK = 'project-create.lock';
const PROJECT_CREATE_LOCK_STALE_MS = 10 * 60 * 1000;
const DEFAULT_API = process.env.VIBEHUB_API || 'https://hub.supermind-ai.cn';
const PLATFORM = platformCommands();
const CLI_DISPLAY = `node "${resolve(process.argv[1])}"`;

const c = { r: '\x1b[31m', g: '\x1b[32m', y: '\x1b[33m', b: '\x1b[34m', d: '\x1b[2m', x: '\x1b[0m', bold: '\x1b[1m' };
const say = (...a) => console.log(...a);
class CliError extends Error {
  constructor(message, hint) {
    super(message);
    this.hint = hint;
  }
}
const die = (message, hint) => { throw new CliError(message, hint); };
const printError = (message, hint) => {
  console.error(`${c.r}✗${c.x} ${message}`);
  if (hint) console.error(`${c.d}  → ${hint}${c.x}`);
};

function loadCred() {
  if (!existsSync(CRED)) die('还没有连接到 VibeHub。', `运行 ${CLI_DISPLAY} bind <邀请码>`);
  const store = loadStore();
  const cred = store.connections[store.active];
  if (!cred) die('当前营地连接已失效。', `运行 ${CLI_DISPLAY} camps 查看连接，或重新 bind`);
  return cred;
}

function connectionKey(cred) {
  const camp = cred.camp?.slug || cred.camp?.id || 'camp';
  const project = cred.project?.id || cred.user?.id || 'profile';
  return `${camp}:${project}`;
}

function normalizeCredential(cred) {
  if (!cred || typeof cred !== 'object' || Array.isArray(cred) || typeof cred.token !== 'string' || !cred.token) {
    die('VibeHub 的本地连接信息损坏了。', '请保留文件并联系老师或技术支持');
  }
  if (cred.local_paths !== undefined && (!Array.isArray(cred.local_paths) || cred.local_paths.some((item) => typeof item !== 'string' || !isAbsolute(item)))) {
    die('VibeHub 的本地连接信息损坏了。', '请保留文件并联系老师或技术支持');
  }
  return { ...cred, local_paths: [...new Set(cred.local_paths || [])] };
}

function normalizeStore(raw) {
  if (raw?.version === 2 && raw.connections && typeof raw.connections === 'object' && !Array.isArray(raw.connections)) {
    const connections = Object.fromEntries(Object.entries(raw.connections).map(([key, cred]) => [key, normalizeCredential(cred)]));
    return { version: 2, active: raw.active ?? null, connections };
  }
  if (raw?.token) {
    const cred = normalizeCredential(raw);
    const key = connectionKey(cred);
    return { version: 2, active: key, connections: { [key]: cred } };
  }
  die('VibeHub 的本地连接信息损坏了。', '请保留文件并联系老师或技术支持');
}

function loadStore(required = true) {
  if (!existsSync(CRED)) {
    if (!required) return { version: 2, active: null, connections: {} };
    die('还没有连接到 VibeHub。', `运行 ${CLI_DISPLAY} bind <邀请码>`);
  }
  try { return normalizeStore(JSON.parse(readFileSync(CRED, 'utf8'))); }
  catch (error) {
    if (error instanceof CliError || error?.code) throw error;
    die('VibeHub 的本地连接信息无法读取。', '请保留文件并联系老师或技术支持');
  }
}

function saveStore(data) {
  writeJsonAtomic(CRED, data, 0o600);
  // Windows 的用户目录使用 ACL；POSIX 系统再收紧为仅本人可读写。
  if (process.platform !== 'win32') chmodSync(CRED, 0o600);
}

function writeFileAtomic(file, contents, mode = 0o600, validateDestination = null) {
  mkdirSync(dirname(file), { recursive: true, mode: 0o700 });
  validateDestination?.();
  const temporary = join(dirname(file), `.${basename(file)}.${process.pid}.${randomBytes(6).toString('hex')}.tmp`);
  try {
    writeFileSync(temporary, contents, { mode, flag: 'wx' });
    if (process.platform !== 'win32') chmodSync(temporary, mode);
    validateDestination?.();
    renameSync(temporary, file);
    validateDestination?.();
  } finally {
    rmSync(temporary, { force: true });
  }
}

function writeJsonAtomic(file, data, mode = 0o600, validateDestination = null) {
  writeFileAtomic(file, `${JSON.stringify(data, null, 2)}\n`, mode, validateDestination);
}

function canonicalDirectory(input = process.cwd()) {
  const candidate = resolve(input);
  if (!existsSync(candidate) || !statSync(candidate).isDirectory()) die('作品目录不存在。', '请检查目录路径后重试');
  return realpathSync(candidate);
}

function bindingPath(dir) {
  return join(dir, BINDING_DIR, BINDING_FILE);
}

function lstatOrNull(file) {
  try { return lstatSync(file); }
  catch (error) {
    if (error?.code === 'ENOENT') return null;
    throw error;
  }
}

function unsafeLocalMetadata() {
  die('本地项目元数据路径不安全，已停止操作。', '请移除符号链接或异常 Git 指针后重试');
}

function validateBindingStorage(dir) {
  const container = join(dir, BINDING_DIR);
  const containerStat = lstatOrNull(container);
  if (containerStat && (containerStat.isSymbolicLink() || !containerStat.isDirectory())) unsafeLocalMetadata();
  const file = bindingPath(dir);
  const fileStat = lstatOrNull(file);
  if (fileStat && (fileStat.isSymbolicLink() || !fileStat.isFile())) unsafeLocalMetadata();
  return { container, file, exists: Boolean(fileStat) };
}

function containsSensitiveField(value) {
  if (!value || typeof value !== 'object') return false;
  return Object.entries(value).some(([key, child]) =>
    /token|authorization|cookie|secret|password|invite|real[_-]?name/i.test(key) || containsSensitiveField(child));
}

function readBinding(dir) {
  const { file, exists } = validateBindingStorage(dir);
  if (!exists) return null;
  let binding;
  try { binding = JSON.parse(readFileSync(file, 'utf8')); }
  catch { die('作品目录绑定已损坏。', '不要手动修改 .vibehub/project.json；请联系老师或技术支持'); }
  if (!binding || typeof binding !== 'object' || Array.isArray(binding)) {
    die('作品目录绑定已损坏。', '不要手动修改 .vibehub/project.json；请联系老师或技术支持');
  }
  if (containsSensitiveField(binding)) {
    die('作品目录绑定包含不安全字段，已停止操作。', '删除敏感字段后，使用 project link 重新关联');
  }
  const keys = Object.keys(binding).sort();
  const finalKeys = ['connection_key', 'project_id', 'version'];
  const pendingKeys = ['pending_request_id', 'version'];
  const isFinal = JSON.stringify(keys) === JSON.stringify(finalKeys)
    && binding.version === 1 && typeof binding.connection_key === 'string' && binding.connection_key
    && typeof binding.project_id === 'string' && binding.project_id;
  const isPending = JSON.stringify(keys) === JSON.stringify(pendingKeys)
    && binding.version === 1 && typeof binding.pending_request_id === 'string'
    && /^pc_[A-Za-z0-9_-]+$/.test(binding.pending_request_id);
  if (!isFinal && !isPending) {
    die('作品目录绑定已损坏。', '不要手动修改 .vibehub/project.json；请联系老师或技术支持');
  }
  return isFinal ? { kind: 'final', ...binding } : { kind: 'pending', ...binding };
}

function writeBinding(dir, binding) {
  const initial = validateBindingStorage(dir);
  if (!lstatOrNull(initial.container)) {
    try { mkdirSync(initial.container, { mode: 0o700 }); }
    catch (error) { if (error?.code !== 'EEXIST') throw error; }
  }
  const validateDestination = () => {
    const current = validateBindingStorage(dir);
    const containerStat = lstatOrNull(current.container);
    if (!containerStat || containerStat.isSymbolicLink() || !containerStat.isDirectory()) unsafeLocalMetadata();
    if (realpathSync(current.container) !== current.container || !isWithin(realpathSync(current.container), dir)) unsafeLocalMetadata();
    if (current.file !== initial.file) unsafeLocalMetadata();
  };
  validateDestination();
  writeJsonAtomic(initial.file, binding, 0o600, validateDestination);
}

function processIsAlive(pid, createdAt) {
  if (!Number.isSafeInteger(pid) || pid <= 0) return false;
  if (!Number.isSafeInteger(createdAt) || Date.now() - createdAt >= PROJECT_CREATE_LOCK_STALE_MS) return false;
  try {
    process.kill(pid, 0);
    return true;
  } catch (error) {
    return error?.code !== 'ESRCH' && error?.code !== 'EINVAL';
  }
}

function readProjectCreateLock(file) {
  const fileStat = lstatOrNull(file);
  if (!fileStat) return null;
  if (fileStat.isSymbolicLink() || !fileStat.isFile()) unsafeLocalMetadata();
  try {
    const value = JSON.parse(readFileSync(file, 'utf8'));
    if (value?.version !== 1 || !Number.isSafeInteger(value.pid) || !Number.isSafeInteger(value.created_at)
      || typeof value.nonce !== 'string' || !value.nonce) {
      unsafeLocalMetadata();
    }
    return value;
  } catch (error) {
    if (error instanceof CliError) throw error;
    if (error?.code === 'ENOENT') return null;
    unsafeLocalMetadata();
  }
}

function sameProjectCreateLock(left, right) {
  return Boolean(left && right && left.pid === right.pid && left.nonce === right.nonce && left.created_at === right.created_at);
}

function claimAndRemoveProjectCreateLock(file, expected) {
  const tombstone = `${file}.claim-${process.pid}-${randomBytes(8).toString('hex')}`;
  try { renameSync(file, tombstone); }
  catch (error) {
    if (error?.code === 'ENOENT') return false;
    throw error;
  }
  const moved = readProjectCreateLock(tombstone);
  if (sameProjectCreateLock(moved, expected)) {
    rmSync(tombstone, { force: true });
    return true;
  }
  // 路径在读取后已被新 owner 替换：把新锁放回，不按路径误删。
  if (!lstatOrNull(file)) renameSync(tombstone, file);
  else rmSync(tombstone, { force: true });
  die('这个目录正在创建作品。', '请稍后重试');
}

function assertProjectCreateLock(lock) {
  if (!sameProjectCreateLock(readProjectCreateLock(lock.file), lock)) {
    die('这个目录的创建权已被其他进程接管。', '保留 pending 绑定并重试');
  }
}

function prepareBindingContainer(dir) {
  const initial = validateBindingStorage(dir);
  if (!lstatOrNull(initial.container)) {
    try { mkdirSync(initial.container, { mode: 0o700 }); }
    catch (error) { if (error?.code !== 'EEXIST') throw error; }
  }
  const current = validateBindingStorage(dir);
  const containerStat = lstatOrNull(current.container);
  if (!containerStat || containerStat.isSymbolicLink() || !containerStat.isDirectory()) unsafeLocalMetadata();
  if (realpathSync(current.container) !== current.container || !isWithin(realpathSync(current.container), dir)) unsafeLocalMetadata();
  return current.container;
}

function acquireProjectCreateLock(dir) {
  const container = prepareBindingContainer(dir);
  const file = join(container, PROJECT_CREATE_LOCK);
  for (let attempt = 0; attempt < 3; attempt += 1) {
    const nonce = randomBytes(12).toString('base64url');
    const createdAt = Date.now();
    const temporary = join(container, `.${PROJECT_CREATE_LOCK}.${process.pid}.${nonce}.tmp`);
    try {
      const owner = { version: 1, pid: process.pid, nonce, created_at: createdAt };
      writeFileSync(temporary, `${JSON.stringify(owner)}\n`, { flag: 'wx', mode: 0o600 });
      linkSync(temporary, file);
      if (prepareBindingContainer(dir) !== container) unsafeLocalMetadata();
      const lock = { file, ...owner };
      assertProjectCreateLock(lock);
      return lock;
    } catch (error) {
      if (error?.code !== 'EEXIST') throw error;
      const owner = readProjectCreateLock(file);
      if (!owner) continue;
      if (processIsAlive(owner.pid, owner.created_at)) {
        die('这个目录正在创建作品。', '请等当前操作完成后再重试');
      }
      claimAndRemoveProjectCreateLock(file, owner);
    } finally {
      rmSync(temporary, { force: true });
    }
  }
  die('这个目录正在创建作品。', '请稍后重试');
}

function releaseProjectCreateLock(lock) {
  try {
    claimAndRemoveProjectCreateLock(lock.file, lock);
  } catch {
    // 不删除不再属于本进程的锁，避免破坏另一个创建请求。
  }
}

function isWithin(child, parent) {
  const offset = relative(parent, child);
  return offset === '' || (!offset.startsWith('..') && !isAbsolute(offset));
}

function canonicalFilePath(file) {
  return join(realpathSync(dirname(file)), basename(file));
}

function validateExcludePath(commonDir) {
  const canonicalCommon = realpathSync(commonDir);
  const info = join(canonicalCommon, 'info');
  let infoStat = lstatOrNull(info);
  if (infoStat && (infoStat.isSymbolicLink() || !infoStat.isDirectory())) unsafeLocalMetadata();
  if (!infoStat) {
    mkdirSync(info);
    infoStat = lstatOrNull(info);
  }
  if (!infoStat || infoStat.isSymbolicLink() || !infoStat.isDirectory()) unsafeLocalMetadata();
  const canonicalInfo = realpathSync(info);
  if (!isWithin(canonicalInfo, canonicalCommon)) unsafeLocalMetadata();
  const exclude = join(canonicalInfo, 'exclude');
  const excludeStat = lstatOrNull(exclude);
  if (excludeStat && (excludeStat.isSymbolicLink() || !excludeStat.isFile())) unsafeLocalMetadata();
  return { commonDir: canonicalCommon, exclude };
}

function worktreeCommonDir(marker, gitDir) {
  const gitDirStat = lstatOrNull(gitDir);
  if (!gitDirStat || gitDirStat.isSymbolicLink() || !gitDirStat.isDirectory()) unsafeLocalMetadata();
  const canonicalGitDir = realpathSync(gitDir);
  const backlink = join(canonicalGitDir, 'gitdir');
  const backlinkStat = lstatOrNull(backlink);
  if (!backlinkStat || backlinkStat.isSymbolicLink() || !backlinkStat.isFile()) unsafeLocalMetadata();
  const backlinkTarget = resolve(dirname(backlink), readFileSync(backlink, 'utf8').trim());
  if (canonicalFilePath(backlinkTarget) !== canonicalFilePath(marker)) unsafeLocalMetadata();
  const commonPointer = join(canonicalGitDir, 'commondir');
  const commonPointerStat = lstatOrNull(commonPointer);
  if (!commonPointerStat || commonPointerStat.isSymbolicLink() || !commonPointerStat.isFile()) unsafeLocalMetadata();
  const commonDir = resolve(canonicalGitDir, readFileSync(commonPointer, 'utf8').trim());
  const canonicalCommon = realpathSync(commonDir);
  if (!isWithin(canonicalGitDir, join(canonicalCommon, 'worktrees'))) unsafeLocalMetadata();
  return canonicalCommon;
}

function findGitExclude(dir) {
  let current = dir;
  while (true) {
    const dotGit = join(current, '.git');
    const markerStat = lstatOrNull(dotGit);
    if (markerStat) {
      if (markerStat.isSymbolicLink()) unsafeLocalMetadata();
      if (markerStat.isDirectory()) return validateExcludePath(realpathSync(dotGit));
      if (!markerStat.isFile()) unsafeLocalMetadata();
      const pointer = /^gitdir:\s*(.+)$/m.exec(readFileSync(dotGit, 'utf8'))?.[1]?.trim();
      if (!pointer) unsafeLocalMetadata();
      return validateExcludePath(worktreeCommonDir(dotGit, resolve(current, pointer)));
    }
    const parent = dirname(current);
    if (parent === current) return null;
    current = parent;
  }
}

function ensureLocalGitExclude(dir) {
  const target = findGitExclude(dir);
  if (!target) return;
  const { commonDir, exclude } = target;
  const existing = existsSync(exclude) ? readFileSync(exclude, 'utf8') : '';
  if (existing.split(/\r?\n/).includes('.vibehub/')) return;
  const originalStat = lstatOrNull(exclude);
  const mode = originalStat ? originalStat.mode & 0o777 : 0o600;
  const validateDestination = () => {
    const current = validateExcludePath(commonDir);
    if (current.commonDir !== commonDir || current.exclude !== exclude || !isWithin(dirname(current.exclude), commonDir)) unsafeLocalMetadata();
  };
  validateDestination();
  writeFileAtomic(exclude, `${existing}${existing && !existing.endsWith('\n') ? '\n' : ''}.vibehub/\n`, mode, validateDestination);
}

function addLocalPath(cred, dir) {
  return { ...cred, local_paths: [...new Set([...(cred.local_paths || []), dir])] };
}

function connectionFingerprint(key) {
  return createHash('sha256').update(key).digest('hex').slice(0, 12);
}

function pendingConnection(store, requestId) {
  const fingerprint = /^pc_([a-f0-9]{12})_/.exec(requestId)?.[1];
  const matches = fingerprint
    ? Object.entries(store.connections).filter(([key]) => connectionFingerprint(key) === fingerprint)
    : [];
  if (matches.length !== 1) {
    die('无法安全恢复这个作品创建请求。', '请保留 .vibehub/project.json 并联系老师或技术支持');
  }
  return matches[0];
}

function bindDirectory(store, key, dir) {
  const cred = store.connections[key];
  if (!cred || cred.project?.id == null) die('目标作品连接已失效。', `运行 ${CLI_DISPLAY} camps 查看连接`);
  const current = readBinding(dir);
  if (current?.kind === 'pending') die('这个目录有未完成的作品创建。', `重新运行 ${CLI_DISPLAY} project create --title "作品名" "${dir}"`);
  if (current?.kind === 'final' && (current.connection_key !== key || String(current.project_id) !== String(cred.project.id))) {
    die('这个目录已经绑定到另一个作品。', '请到正确的作品目录操作，不要覆盖绑定文件');
  }
  ensureLocalGitExclude(dir);
  writeBinding(dir, { version: 1, connection_key: key, project_id: String(cred.project.id) });
  store.connections[key] = addLocalPath(cred, dir);
  store.active = key;
  saveStore(store);
  return store.connections[key];
}

function resolveDeployCredential(dir) {
  const store = loadStore();
  const binding = readBinding(dir);
  if (binding?.kind === 'pending') {
    die('这个目录的作品创建还没有完成。', `重新运行 ${CLI_DISPLAY} project create --title "作品名" "${dir}"`);
  }
  if (binding?.kind === 'final') {
    const cred = store.connections[binding.connection_key];
    if (!cred || String(cred.project?.id) !== String(binding.project_id)) {
      die('目录绑定与本地连接不一致，已停止部署。', `运行 ${CLI_DISPLAY} camps 检查连接，再用 project link 修复`);
    }
    if (!cred.local_paths.includes(dir)) {
      die('这个 binding 可能是从另一个目录复制来的，已停止操作。', `运行 ${CLI_DISPLAY} project link ${binding.connection_key} "${dir}" 明确登记此目录`);
    }
    ensureLocalGitExclude(dir);
    return store.connections[binding.connection_key];
  }
  const entries = Object.entries(store.connections);
  // 兼容最早期只保存 token/api 的单连接凭证；它可以继续部署，但不会制造无法校验的目录绑定。
  if (entries.length === 1 && entries[0][1].project?.id == null) return entries[0][1];
  if (entries.length === 1 && entries[0][1].local_paths.length === 0) {
    return bindDirectory(store, entries[0][0], dir);
  }
  die('这个作品目录还没有绑定，无法确定部署目标。', `运行 ${CLI_DISPLAY} project link <完整连接标识> "${dir}"`);
}

function resolveReadCredential(dir) {
  const store = loadStore();
  const binding = readBinding(dir);
  if (binding?.kind === 'pending') {
    die('这个目录的作品创建还没有完成。', `重新运行 ${CLI_DISPLAY} project create --title "作品名" "${dir}"`);
  }
  if (binding?.kind === 'final') {
    const cred = store.connections[binding.connection_key];
    if (!cred || String(cred.project?.id) !== String(binding.project_id)) {
      die('目录绑定与本地连接不一致，已停止操作。', `运行 ${CLI_DISPLAY} camps 检查连接，再用 project link 修复`);
    }
    if (!cred.local_paths.includes(dir)) {
      die('这个 binding 可能是从另一个目录复制来的，已停止操作。', `运行 ${CLI_DISPLAY} project link ${binding.connection_key} "${dir}" 明确登记此目录`);
    }
    ensureLocalGitExclude(dir);
    return store.connections[binding.connection_key];
  }
  const entries = Object.entries(store.connections);
  if (entries.length === 1 && (entries[0][1].project?.id == null || entries[0][1].local_paths.length === 0)) return entries[0][1];
  die('这个作品目录还没有绑定，无法确定目标作品。', `运行 ${CLI_DISPLAY} project link <完整连接标识> "${dir}"`);
}

async function api(path, { method = 'GET', body, token, form, credential } = {}) {
  const cred = token === false ? null : (credential || (token ? { token } : (existsSync(CRED) ? loadCred() : null)));
  const headers = {};
  if (cred?.token) headers.authorization = `Bearer ${cred.token}`;
  let payload;
  if (form) payload = form;
  else if (body !== undefined) { headers['content-type'] = 'application/json'; payload = JSON.stringify(body); }
  const base = cred?.api || DEFAULT_API;
  const res = await fetch(base + path, { method, headers, body: payload });
  const data = await res.json().catch(() => ({}));
  if (!res.ok) die(data.error?.message || `请求失败（${res.status}）`, data.error?.hint);
  return data;
}

function previewId(url) {
  try { return /\/vibehub\/_preview\/([a-z0-9]+)\//i.exec(new URL(url).pathname)?.[1] || null; } catch { return null; }
}

async function grantPreview(url, credential) {
  const pid = previewId(url);
  if (!pid) return url;
  const grant = await api(`/api/previews/${encodeURIComponent(pid)}/grant`, { method: 'POST', credential });
  return grant.preview_url;
}

function cleanPreviewUrl(url) {
  if (!url) return url;
  try {
    const cleaned = new URL(url);
    cleaned.searchParams.delete('claim');
    return cleaned.toString();
  } catch { return url; }
}

// ── 打包 ─────────────────────────────────────────────────────────────
const IGNORE = new Set([
  'node_modules', '.git', '.DS_Store', 'dist.tgz', '.vibehub', 'venv', '__pycache__', '.venv',
  '.env', '.env.*', '*.pem', '*.key', 'id_rsa*', 'id_ed25519*', '*.pfx', '*.p12',
  'credentials.json', '.npmrc', '*.log', '.aws', '.ssh',
]);

function isIgnoredName(name, ignore = IGNORE) {
  const lower = name.toLowerCase();
  return ignore.has(name)
    || lower === '.env'
    || lower.startsWith('.env.')
    || lower.endsWith('.pem')
    || lower.endsWith('.key')
    || lower.startsWith('id_rsa')
    || lower.startsWith('id_ed25519')
    || lower.endsWith('.pfx')
    || lower.endsWith('.p12')
    || lower.endsWith('.log')
    || lower === 'credentials.json'
    || lower === '.npmrc';
}

function readIgnoreFile(dir) {
  const f = join(dir, '.vibehubignore');
  if (!existsSync(f)) return [];
  return readFileSync(f, 'utf8').split('\n').map((s) => s.trim()).filter((s) => s && !s.startsWith('#'));
}

function pickSourceDir(dir) {
  // 有构建产物就用产物；否则用当前目录
  const pkgPath = join(dir, 'package.json');
  if (existsSync(pkgPath)) {
    const pkg = JSON.parse(readFileSync(pkgPath, 'utf8'));
    if (pkg.scripts?.build) {
      say(`${c.d}检测到构建脚本，先跑一次 npm run build …${c.x}`);
      try { execFileSync(PLATFORM.npm.command, [...PLATFORM.npm.prefix, 'run', 'build'], { cwd: dir, stdio: 'inherit' }); }
      catch { die('构建失败了。', '先在本地把 npm run build 跑通再提交'); }
    }
    for (const d of ['dist', 'build', 'out', 'public']) {
      if (existsSync(join(dir, d, 'index.html'))) { say(`${c.d}使用构建产物目录 ${d}/${c.x}`); return join(dir, d); }
    }
  }
  return dir;
}

function makeTarball(srcDir) {
  const extra = readIgnoreFile(srcDir);
  const testRoot = process.env.NODE_ENV === 'test' ? process.env.VIBEHUB_TEST_TMPDIR : null;
  const archiveRoot = testRoot ? resolve(testRoot) : tmpdir();
  mkdirSync(archiveRoot, { recursive: true });
  const out = join(archiveRoot, `vibehub_${Date.now()}_${process.pid}.tgz`);
  const args = ['-czf', out];
  for (const name of [...IGNORE, ...extra]) args.push('--exclude', name);
  args.push('-C', srcDir, '.');
  // COPYFILE_DISABLE=1：不让 macOS 的 tar 附带 AppleDouble(._xxx) 扩展属性文件
  try {
    execFileSync(PLATFORM.tar, args, { stdio: 'pipe', env: { ...process.env, COPYFILE_DISABLE: '1' } });
  } catch {
    rmSync(out, { force: true });
    die('作品打包失败了。', process.platform === 'win32'
      ? '请确认使用 Windows 10/11，并在终端运行 tar --version 检查系统打包工具'
      : '请在终端运行 tar --version 检查系统打包工具');
  }
  return out;
}

function countFiles(dir, ignore = IGNORE) {
  let n = 0;
  const walk = (d) => {
    for (const name of readdirSync(d)) {
      if (isIgnoredName(name, ignore)) continue;
      const p = join(d, name);
      const st = statSync(p);
      if (st.isDirectory()) walk(p); else n += 1;
    }
  };
  walk(dir);
  return n;
}

// ── 命令 ─────────────────────────────────────────────────────────────
const cmds = {
  async bind(code, ...args) {
    if (!code) die('请提供邀请码。', `用法：${CLI_DISPLAY} bind <邀请码>`);
    let realName, displayName;
    for (let i = 0; i < args.length; i++) {
      if (args[i] === '--name') realName = args[++i];
      else if (args[i] === '--nickname') displayName = args[++i];
      else die(`不认识参数 ${args[i]}。`, `用法：${CLI_DISPLAY} bind <邀请码> --name "真实姓名" --nickname "公开昵称"`);
    }
    // 先确认旧连接可读，避免服务端已签发 token 后才发现本地无法保存。
    loadStore(false);
    const api_base = process.env.VIBEHUB_API || DEFAULT_API;
    const res = await fetch(api_base + '/api/skill/bind', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ code, device_name: `${basename(homedir())} · ${process.env.TERM_PROGRAM || process.env.COMPUTERNAME || 'CLI'}`,
        ...(realName ? { real_name: realName } : {}), ...(displayName ? { display_name: displayName } : {}) }),
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) die(data.error?.message || '绑定失败', data.error?.hint);
    // 联网期间 project link/create 可能已更新本地路径；回包后重读，不用旧快照覆盖。
    const store = loadStore(false);
    const key = connectionKey({ camp: data.camp, project: data.project, user: data.user });
    const preservedPaths = store.connections[key]?.local_paths || [];
    const cred = { token: data.token, api: api_base, camp: data.camp, project: data.project, local_paths: preservedPaths,
      user: data.user ? { id: data.user.id, username: data.user.username, display_name: data.user.display_name } : null };
    store.version = 2;
    store.connections[key] = cred;
    store.active = key;
    saveStore(store);
    say(`${c.g}✓${c.x} ${data.message}`);
    say(`${c.d}凭证已保存到 ${CRED}${c.x}`);
    say(`\n下一步：写好你的网页，然后运行 ${c.bold}${CLI_DISPLAY} deploy${c.x}`);
  },

  camps() {
    const store = loadStore();
    say(`\n${c.bold}已经连接的营地${c.x}`);
    for (const [key, cred] of Object.entries(store.connections)) {
      const current = key === store.active ? `  ${c.g}当前${c.x}` : '';
      const project = cred.project?.title ? ` · ${cred.project.title}` : '';
      say(`  ${cred.camp?.name || key}${project}${current}`);
      say(`    ${c.d}连接标识 ${key}${c.x}`);
    }
    say('');
  },

  use(query) {
    if (!query) die('请告诉我要切换到哪个营地。', `先运行 ${CLI_DISPLAY} camps 查看营地列表`);
    const store = loadStore();
    const wanted = String(query).trim().toLowerCase();
    const matches = Object.entries(store.connections).filter(([key, cred]) =>
      key.toLowerCase() === wanted
      || String(cred.camp?.slug || '').toLowerCase() === wanted
      || String(cred.camp?.name || '').toLowerCase() === wanted);
    if (!matches.length) die(`没有找到“${query}”。`, `运行 ${CLI_DISPLAY} camps 查看可切换的营地`);
    if (matches.length > 1) die(`“${query}”对应多个连接。`, `请使用 ${CLI_DISPLAY} camps 显示的完整连接标识`);
    store.active = matches[0][0];
    saveStore(store);
    say(`${c.g}✓${c.x} 已切换到《${matches[0][1].camp?.name || query}》`);
  },

  async project(action, ...args) {
    if (action === 'link') {
      const [key, directory, ...extra] = args;
      if (!key || extra.length || String(directory || '').startsWith('-')) {
        die('请提供完整连接标识。', `用法：${CLI_DISPLAY} project link <完整连接标识> [目录]`);
      }
      const dir = canonicalDirectory(directory || process.cwd());
      const store = loadStore();
      if (!Object.hasOwn(store.connections, key)) {
        die('没有找到这个完整连接标识。', `运行 ${CLI_DISPLAY} camps 查看连接标识`);
      }
      const cred = bindDirectory(store, key, dir);
      say(`${c.g}✓${c.x} 已关联《${cred.project?.title || cred.project?.id}》到当前目录`);
      return;
    }
    if (action === 'create') {
      let title = null;
      let directory = null;
      let from = null;
      for (let i = 0; i < args.length; i += 1) {
        if (args[i] === '--title') title = args[++i];
        else if (args[i] === '--from') from = args[++i];
        else if (!args[i].startsWith('-') && directory === null) directory = args[i];
        else die(`不认识参数 ${args[i]}。`, `用法：${CLI_DISPLAY} project create --title "作品名" [--from <完整连接标识>] [目录]`);
      }
      if (!title || !String(title).trim()) die('请提供作品名称。', `用法：${CLI_DISPLAY} project create --title "作品名" [--from <完整连接标识>] [目录]`);
      if (from !== null && (!from || String(from).startsWith('-'))) die('请在 --from 后提供完整连接标识。', `运行 ${CLI_DISPLAY} camps 查看`);
      const dir = canonicalDirectory(directory || process.cwd());
      const observed = readBinding(dir);
      if (observed?.kind === 'final') die('这个目录已经绑定到一个作品。', '直接 deploy，或到另一个目录创建新作品');
      const observedStore = loadStore();
      if (!observed && from && !Object.hasOwn(observedStore.connections, from)) {
        die('没有找到 --from 指定的完整连接标识。', `运行 ${CLI_DISPLAY} camps 查看`);
      }
      if (!observed && !from && Object.keys(observedStore.connections).length !== 1) {
        die('多个作品连接中无法猜测新作品所属营地。', `运行 ${CLI_DISPLAY} camps，再加 --from <完整连接标识>`);
      }

      const createLock = acquireProjectCreateLock(dir);
      try {
        const existing = readBinding(dir);
        if (existing?.kind === 'final') die('这个目录已经绑定到一个作品。', '直接 deploy，或到另一个目录创建新作品');
        const authorizationStore = loadStore();
        let authorization;
        if (existing) {
          authorization = pendingConnection(authorizationStore, existing.pending_request_id);
          if (from && from !== authorization[0]) die('--from 与待恢复创建请求的授权连接不一致。', `使用完整连接标识 ${authorization[0]}`);
        } else if (from) {
          authorization = Object.hasOwn(authorizationStore.connections, from) ? [from, authorizationStore.connections[from]] : null;
          if (!authorization) die('没有找到 --from 指定的完整连接标识。', `运行 ${CLI_DISPLAY} camps 查看`);
        } else {
          const entries = Object.entries(authorizationStore.connections);
          if (entries.length !== 1) die('多个作品连接中无法猜测新作品所属营地。', `运行 ${CLI_DISPLAY} camps，再加 --from <完整连接标识>`);
          authorization = entries[0];
        }
        const [authorizationKey, authorizer] = authorization;
        if (!authorizer) die('当前营地连接已失效。', `运行 ${CLI_DISPLAY} camps 查看连接，或重新 bind`);
        ensureLocalGitExclude(dir);
        const requestId = existing?.pending_request_id
          || `pc_${connectionFingerprint(authorizationKey)}_${randomBytes(12).toString('base64url')}`;
        if (!existing) writeBinding(dir, { version: 1, pending_request_id: requestId });

        const data = await api('/api/skill/projects', {
          method: 'POST', body: { title: String(title).trim(), request_id: requestId }, credential: authorizer,
        });
        assertProjectCreateLock(createLock);
        if (!data.token || !data.project?.id || !data.camp) die('平台返回的作品连接不完整。', '保留目录后重试；仍有问题请联系老师');
        const cred = normalizeCredential({
          token: data.token,
          api: authorizer.api || DEFAULT_API,
          camp: data.camp,
          project: data.project,
          user: data.user ? { id: data.user.id, username: data.user.username, display_name: data.user.display_name } : authorizer.user,
          local_paths: [dir],
        });
        const key = connectionKey(cred);
        const store = loadStore();
        store.connections[key] = cred;
        store.active = key;
        saveStore(store);
        writeBinding(dir, { version: 1, connection_key: key, project_id: String(data.project.id) });
        say(`${c.g}✓${c.x} ${data.message || `已创建《${data.project.title}》`}`);
        say(`下一步：运行 ${c.bold}${CLI_DISPLAY} deploy "${dir}"${c.x}`);
        return;
      } finally {
        releaseProjectCreateLock(createLock);
      }
    }
    die('请指定 project create 或 project link。', `运行 ${CLI_DISPLAY} help 查看用法`);
  },

  async status() {
    const credential = resolveReadCredential(canonicalDirectory(process.cwd()));
    const s = await api('/api/skill/project', { credential });
    const p = s.project;
    const pendingPreviewUrl = cleanPreviewUrl(s.pending_version?.preview_url);
    say(`\n${c.bold}${p.title}${c.x}  ${c.d}${s.camp.name}${c.x}`);
    say(`${c.d}────────────────────────────────${c.x}`);
    const statusText = { unpublished: '还没上线', published: '已上线', published_with_pending: '已上线（有新版本待审核）', suspended: '已下线' };
    say(`状态      ${statusText[p.publish_status] || p.publish_status}`);
    if (s.live_version) say(`线上版本  ${c.g}${s.live_version.label}${c.x}   ${p.live_url || ''}`);
    if (s.pending_version) {
      say(`待审版本  ${c.y}${s.pending_version.label}${c.x}   ${pendingPreviewUrl}`);
      say(`          ${c.d}运行 ${CLI_DISPLAY} open 可安全打开预览${c.x}`);
      say(`          ${c.d}审核通过后才会替换线上版本${c.x}`);
    }
    const d = s.latest_diagnosis;
    if (d && d.status === 'failed') {
      // failed = 诊断本身没跑完，但版本已经提交、进了老师的审核队列（服务端仍会建 review）。
      // 别说「重新 deploy 就会重新诊断」——相同内容会被判重、直接跳过，不会重新入队。
      say(`\n${c.y}这次诊断没跑完${c.x}，不过你的版本已经提交，老师可以直接审核。`);
      say(`${c.d}想重新诊断的话，改一点内容再 ${c.x}${c.bold}${CLI_DISPLAY} deploy${c.x}${c.d} 就会重新跑。${c.x}`);
    } else if (d) {
      const completeness = d.status === 'running'
        ? null
        : (Number.isFinite(d.completeness) ? d.completeness : d.score);
      const coverage = Number.isFinite(d.verified_ratio) ? `${d.verified_ratio}%` : '—';
      if (Number.isFinite(completeness)) {
        say(`\n开发完成度  ${c.bold}${completeness}%${c.x}  ${c.d}(${d.applicable_earned}/${d.applicable_max} 分，只算适用项)${c.x}`);
        say(`          验证覆盖率 ${coverage}`);
      } else {
        say(`\n${c.d}诊断正在进行，稍后用 ${CLI_DISPLAY} status 查看${c.x}`);
      }
      if (d.stale) say(`          ${c.y}诊断更新中，以上是上一版本结果${c.x}`);
      if (d.blocked || d.status === 'blocked') say(`          ${c.r}有阻塞问题，先修好再提交审核${c.x}`);
      if (d.summary) say(`          ${d.summary}`);
      for (const i of d.items) {
        const mark = i.applicability === 'not_applicable' ? `${c.d}—${c.x}`
          : i.result === 'pass' ? `${c.g}✓${c.x}` : i.result === 'fail' ? `${c.r}✗${c.x}` : `${c.y}?${c.x}`;
        const pts = i.applicability === 'not_applicable' ? `${c.d}不适用${c.x}` : `${i.earned_points}/${i.max_points}`;
        say(`  ${mark} ${i.label.padEnd(18, ' ')} ${pts}`);
      }
      if (d.next_steps?.length) {
        say(`\n${c.bold}下一步${c.x}`);
        d.next_steps.forEach((n, i) => say(`  ${i + 1}. ${n}`));
      }
    }
    if (s.last_review?.status === 'rejected') {
      say(`\n${c.y}老师退回了${c.x}：${s.last_review.comment}`);
    }
    say('');
  },

  async deploy(...args) {
    let summary = null, flows = [], label = null, dir = process.cwd();
    for (let i = 0; i < args.length; i++) {
      if (args[i] === '--summary') summary = args[++i];
      else if (args[i] === '--flows') flows = String(args[++i]).split(',').map((s) => s.trim()).filter(Boolean);
      else if (args[i] === '--label') label = args[++i];
      else if (!args[i].startsWith('-')) dir = args[i];
      else die(`不认识参数 ${args[i]}。`, `运行 ${CLI_DISPLAY} help 查看用法`);
    }

    dir = canonicalDirectory(dir);
    const cred = resolveDeployCredential(dir);
    const suffix = String(cred.project?.id || '').slice(-6);
    say(`${c.d}目标：${cred.camp?.name || cred.camp?.slug || '营地'} · ${cred.project?.title || '作品'}${suffix ? ` (${suffix})` : ''}${c.x}`);
    const src = pickSourceDir(dir);
    if (!existsSync(join(src, 'index.html'))) {
      die('没找到 index.html，你的网页需要有一个首页文件。',
        '确认你在网页目录里；如果用了构建工具，先 npm run build');
    }

    say(`${c.d}打包 ${relative(process.cwd(), src) || '.'} …${c.x}`);
    const tgz = makeTarball(src);
    try {
      const size = statSync(tgz).size;
      const sha = createHash('sha256').update(readFileSync(tgz)).digest('hex');
      say(`${c.d}${countFiles(src)} 个文件，${(size / 1024).toFixed(0)} KB${c.x}`);

      const pre = await api('/api/skill/versions/preflight', { method: 'POST', body: { sha256: sha, size }, credential: cred });
      if (pre.duplicate) { say(`${c.y}○${c.x} ${pre.message}`); return; }

      const fd = new FormData();
      fd.append('meta', JSON.stringify({ label, summary, flows }));
      fd.append('bundle', new Blob([readFileSync(tgz)]), 'bundle.tgz');
      const res = await fetch(cred.api + '/api/skill/versions', {
        method: 'POST', headers: { authorization: `Bearer ${cred.token}` }, body: fd,
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) die(data.error?.message || '提交失败', data.error?.hint);

      say(`\n${c.g}✓${c.x} ${data.label} 已提交`);
      say(`  预览  ${c.b}${cleanPreviewUrl(data.preview_url)}${c.x}`);
      say(`  ${c.d}安全预览已准备，可运行 ${CLI_DISPLAY} open 打开${c.x}`);
      if (data.rewrites) say(`  ${c.d}自动修正了 ${data.rewrites} 处绝对路径引用（作品跑在子目录下）${c.x}`);
      if (Number.isFinite(data.diagnosis?.score)) {
        const conclusion = data.diagnosis.summary ? ` — ${data.diagnosis.summary}` : '';
        say(`  完成度 ${c.bold}${data.diagnosis.score}%${c.x}${conclusion}`);
        (data.diagnosis.next_steps || []).forEach((n) => say(`    ${c.d}·${c.x} ${n}`));
      } else {
        say(`  ${c.d}正在做诊断，稍后用 ${CLI_DISPLAY} status 查看${c.x}`);
      }
      say(`\n${data.message}`);
    } finally {
      rmSync(tgz, { force: true });
    }
  },

  async open() {
    const credential = resolveReadCredential(canonicalDirectory(process.cwd()));
    const s = await api('/api/skill/project', { credential });
    const openingPreview = !!s.pending_version?.preview_url;
    const url = openingPreview ? await grantPreview(s.pending_version.preview_url, credential) : s.project.live_url;
    if (!url) die('还没有可打开的版本。', `先运行 ${CLI_DISPLAY} deploy`);
    try {
      execFileSync(PLATFORM.opener.command, [...PLATFORM.opener.prefix, url]);
    } catch {
      die(openingPreview ? '浏览器没有成功打开安全预览。' : '浏览器没有成功打开正式作品。', '请检查系统默认浏览器后重试');
    }
    say(openingPreview ? '已在浏览器打开安全预览' : `已打开 ${url}`);
  },

  async logs() {
    const credential = resolveReadCredential(canonicalDirectory(process.cwd()));
    const s = await api('/api/skill/project', { credential });
    say(`\n${c.bold}最近发生了什么${c.x}`);
    for (const e of s.timeline || []) {
      const icon = { submit: '↑', publish: '✓', reject: '↩' }[e.kind] || '·';
      say(`  ${icon} ${c.d}${e.at.slice(5, 16).replace('T', ' ')}${c.x}  ${e.title}  ${c.d}${e.detail || ''}${c.x}`);
    }
    say('');
  },

  help() {
    say(`
${c.bold}vibehub${c.x} — 把你的作品交给 VibeHub

  ${c.bold}${CLI_DISPLAY} bind <邀请码>${c.x}   用邀请码连上平台
      --name "真实姓名" --nickname "公开昵称"（首次连接学员码时使用）
  ${c.bold}${CLI_DISPLAY} camps${c.x}            查看已经连接的营地
  ${c.bold}${CLI_DISPLAY} use <营地标识>${c.x}   切换当前营地
  ${c.bold}${CLI_DISPLAY} project create --title "作品名" [--from <完整连接标识>] [目录]${c.x}
                              为目录创建并绑定一个新作品
  ${c.bold}${CLI_DISPLAY} project link <完整连接标识> [目录]${c.x}
                              把目录关联到已有作品
  ${c.bold}${CLI_DISPLAY} deploy${c.x}           打包当前目录并提交
      --summary "本次更新说明"
      --flows "上传声音,查看地图"    声明核心操作路径（诊断会用到）
  ${c.bold}${CLI_DISPLAY} status${c.x}           看当前状态与 AI 诊断
  ${c.bold}${CLI_DISPLAY} logs${c.x}             看最近的提交与审核记录
  ${c.bold}${CLI_DISPLAY} open${c.x}             在浏览器打开你的作品
`);
  },
};

const [cmd, ...rest] = process.argv.slice(2);
const fn = cmds[cmd] || cmds.help;
Promise.resolve()
  .then(() => fn(...rest))
  .catch((error) => {
    if (error instanceof CliError) printError(error.message, error.hint);
    else printError('操作没有完成。', '请检查网络和本地文件后重试；仍有问题请联系老师或技术支持');
    process.exitCode = 1;
  });
